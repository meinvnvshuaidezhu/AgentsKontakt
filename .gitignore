# ---- data areas: runtime state, never versioned ----
mailboxes/
archive/
archive.bak-20261001/
post/
logs/
.workbuddy/
.zcode/

# packaging artifacts (zips + release/acceptance reports under dist\)
dist/

# generated dashboard output (regenerated by scripts\core\dashboard.ps1)
dashboard/
dashboard.html
dashboard-data.js

# runtime junk
*.log
*.tmp
close.tmp
NUL
__pycache__/

# secrets (only the *.example.json template is versioned)
config/smtp.json

# app runtime data
app/userdata/

# one-off experiments and stale backups (kept on disk, superseded by git history)
scratch/
AGENTS.md.bak-*
assets/*.bak
assets/*.zcode-backup.xml
assets/poll-notify-last.txt

# disposable install/regression sandbox roots (recreated by test runs)
test-data*/
test-install/
